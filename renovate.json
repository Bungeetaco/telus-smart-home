{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommitsDisabled"
  ],
  "labels": [
    "dependencies"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "MediaMTX static binary version pinned as a Dockerfile ARG",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "ARG MEDIAMTX_VERSION=(?<currentValue>v[0-9][^\\s]*)"
      ],
      "depNameTemplate": "bluenviron/mediamtx",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "Low-risk: auto-merge minor/patch once CI is green",
      "matchPackageNames": [
        "python"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "High-risk: the SSO monkeypatch targets pyalarmdotcomajax internals; aiortc/av must keep manylinux wheels and aiortc.sdp is a private import; aiohttp/websockets carry the deprecation exposure (ClientSession/AppKey/legacy protocol aliases); MediaMTX config format can change. Never auto-merge -- review with CI.",
      "matchPackageNames": [
        "pyalarmdotcomajax",
        "aiortc",
        "av",
        "bluenviron/mediamtx",
        "aiohttp",
        "websockets"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "review-required"
      ]
    }
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "homeassistant-manifest": {
    "enabled": true
  }
}

# Copy this file to secrets.env and fill in real values. secrets.env is
# gitignored -- never commit it. Deliberately kept separate from .env: if
# your password contains a literal "$", it must be escaped as "$$" here --
# Docker Compose interpolates $-references in env_file values, and an
# unescaped "$" gets silently corrupted otherwise (verified during
# development, not a hypothetical). install.sh does this escaping for you
# automatically if you let it prompt for credentials instead of hand-editing
# this file.

TELUS_EMAIL=you@example.com
TELUS_PASSWORD=your-telus-password

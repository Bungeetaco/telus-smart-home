# Copy this file to .env. Non-secret settings only -- credentials live in
# secrets.env instead (see secrets.env.example), kept separate because Docker
# Compose interpolates $-references in env_file values and a password with a
# literal "$" needs escaping that doesn't belong mixed in with plain config.

# Optional overrides -- defaults shown are what this project was built/tested against.
# MEDIAMTX_RTSP_PORT=8554
# LOG_LEVEL=INFO
# CONTROL_PORT=8199

# Host-side path for the directory shared with Home Assistant's own container
# (holds the control-endpoint secret and the credential fallback file -- see
# the top-level README). Defaults to the Home Assistant Supervised layout;
# override this if you're on a different install type or a non-default path.
# HOST_SHARED_DIR=/var/lib/homeassistant/share/telus_cam_bridge

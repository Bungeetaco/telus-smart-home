# Copy this file to .env. Non-secret settings only -- credentials live in
# secrets.env instead (see secrets.env.example), kept separate because Docker
# Compose interpolates $-references in env_file values and a password with a
# literal "$" needs escaping that doesn't belong mixed in with plain config.

# Optional overrides -- defaults shown are what this project was built/tested against.
# MEDIAMTX_RTSP_PORT=8554
# LOG_LEVEL=INFO
# CONTROL_PORT=8199

# Log one line per control-API request (aiohttp's access log). Off by default:
# every request is loopback polling from Home Assistant, and the routine access
# lines were measured at roughly a quarter of all log output -- enough to age
# real warnings out of the container's capped log rotation (10m x 3 files).
# Failures still log through the route handlers themselves; set true only when
# debugging the control API's request flow.
# CONTROL_ACCESS_LOG=true

# EXPERIMENT (off by default): ask Alarm.com's Janus gateway for a downstream
# audio track alongside the video when creating the mountpoint. The bridge does
# NOT consume audio -- ffmpeg publishes video only and an offered audio track is
# drained -- so this cannot put sound in the RTSP feed. It exists so the offer
# summary in the log reveals whether the upstream would serve audio at all.
# Safe to leave on: a rejected create is retried once with the normal
# video-only body, so it can never fail a camera session.
#
# PER-CAMERA, because requesting audio is not free for every camera: asked for
# audio, the gateway offers an audio m-line FIRST, and one camera on this
# account kept streaming through that while a slower one stopped producing a
# first frame and reconnected in a loop. Accepted values:
#   false / 0 / no / off (or unset) -- off for every camera (the default; the
#                                      create body is byte-identical to the
#                                      video-only body that has always shipped)
#   true / 1 / yes / on / all       -- on for every camera
#   <camera-id>[,<camera-id>...]    -- on for exactly those cameras (exact id
#                                      match, spaces around ids are fine)
# Which mode applied is logged per camera at session start.
# JANUS_REQUEST_AUDIO=true
# JANUS_REQUEST_AUDIO=<doorbell-camera-id>

# Publish the downstream audio track on the camera's RTSP path, alongside the
# video. OFF by default. Same three value forms as JANUS_REQUEST_AUDIO above
# (off / all / a comma-separated list of camera ids), and the same rule that the
# keywords are only recognised as the WHOLE value.
#
# It REQUIRES JANUS_REQUEST_AUDIO to name the same camera: a camera named only
# here is never offered an audio track at all, so the combination is logged once
# and treated as off rather than giving ffmpeg a second input that can only ever
# carry silence.
#
# For a camera it applies to, the publisher gains a second raw-PCM input and the
# output carries mono AAC at the rate the decoded frames actually arrive at. AAC
# is not a preference: Home Assistant's HLS worker accepts only aac/mp3, and
# Frigate's `-c copy` recording preset needs an mp4-legal codec.
# JANUS_CONSUME_AUDIO=<doorbell-camera-id>

# Two-way audio (talkdown): playing audio out a doorbell-class camera's speaker,
# via the bridge's /control/cameras/<id>/talk endpoint and Home Assistant's
# telus_smarthome.speak service. ENABLED by default -- nothing ever speaks on its
# own, the endpoint only plays what a caller explicitly asks it to. Set this false
# to make the endpoint refuse every talk request with 403 talkdown_disabled.
# TALKDOWN_ENABLED=false

# Most talkdown tunables are plain constants in bridge/config.py rather than
# environment variables, because they are tuning rather than deployment config:
# TALK_AUDIO_FILTER (the small-speaker conditioning chain applied to every clip),
# TALK_CODEC, TALK_PUT_ENDPOINT_ORDER, TALK_MAX_RENEGOTIATIONS, TALK_CHUNK_MS /
# TALK_PREBUFFER_MS (tuned BY EAR against the real speaker -- changing either
# needs a listening test) and the various TALK_*_TIMEOUT_S values. See
# docs/configuration.md for the full list.

# The talkdown settings that ARE environment variables, because they are about a
# particular deployment or are escape hatches for a live regression:

# Which PutAudioStream endpoint to use, overriding runtime reachability
# detection: direct | local | public | cloud. Empty (the default) auto-detects by
# probing, preferring the LAN. An endpoint the doorbell does not advertise is
# ignored with a warning rather than failing the talk.
# TALK_PUT_ENDPOINT=
# How long a reachability probe (a bare TCP connect) may take. 0 disables
# probing and restores a blind walk down TALK_PUT_ENDPOINT_ORDER.
# TALK_ENDPOINT_PROBE_TIMEOUT_S=1.0

# Feed the PUT loop from ffmpeg as it decodes instead of buffering the whole
# encoded clip first (lower latency to first audio, bounded memory). Set false
# to restore buffer-then-send if it ever misbehaves in the field.
# TALK_STREAMING_ENCODE=false

# TLS certificate pinning for the doorbell's own (self-signed) audio endpoint.
# Mode: warn (default -- detect and log a mismatch, never block audio) |
# enforce (refuse a mismatched certificate) | off (no check).
# The pinned value ships as the fingerprint OBSERVED ON ONE ADC-VDB750; a
# firmware update, factory reset or replacement unit legitimately changes it,
# which is why "warn" is the default. A mismatch logs the presented fingerprint
# so it can be adopted here.
# TALK_TLS_PIN_MODE=warn
# TALK_DEVICE_CERT_SHA256=

# Let the jitter-buffer lead grow to cover observed round-trip jitter. Off by
# default: the fixed lead was tuned by ear and adapting it has not had a
# listening test. Measurement is always on regardless; the numbers come back in the talk
#   response, not in /control/metrics.
# TALK_PREBUFFER_ADAPTIVE=true

# Hardware video-encode backend for ffmpeg_sink.py: "vaapi" (Intel QuickSync or
# AMD, via /dev/dri -- this project's own deployment), "nvenc" (NVIDIA, via
# nvidia-container-toolkit -- see docker-compose.yml's commented-out NVIDIA
# section; not verified against real NVIDIA hardware by this project), or
# "software" (always libx264, skip hardware entirely).
# ENCODE_BACKEND=vaapi

# Render node handed to ffmpeg for VAAPI encoding. Override if the host has more
# than one GPU and the numbering differs (docker-compose.yml passes /dev/dri
# through, and RENDER_GID must match `getent group render` on the host).
# VAAPI_DEVICE=/dev/dri/renderD128

# Container resource caps (docker-compose.yml). Defaults leave generous
# headroom above this project's measured live usage (2 cameras: ~14-31% of one
# core, ~326MB RSS) -- raise if you're running more cameras.
# BRIDGE_MEM_LIMIT=768m
# BRIDGE_CPU_LIMIT=2.0

# Host-side path for the directory shared with Home Assistant's own container
# (holds the control-endpoint secret and the credential fallback file -- see
# the top-level README). Defaults to the Home Assistant Supervised layout;
# override this if you're on a different install type or a non-default path.
# HOST_SHARED_DIR=/var/lib/homeassistant/share/telus_cam_bridge

# NOTE: RTSP_PASSWORD is NOT a setting to put here. The container's entrypoint
# generates it on first start, stores it in the shared directory (mode 0600) and
# injects it -- see the top-level README's "Camera stream authentication".

            "invalid_otp": "Неверный одноразовый пароль.",
            "telus_sso_error": "Процесс единого входа TELUS вернул непредвиденный результат. Обычно это означает, что TELUS изменила что-то на стороне сервера, а не то, что пароль неверен."
        },
        "abort": {
            "reauth_successful": "[%key:common::config_flow::abort::reauth_successful%]",
            "reconfigure_successful": "[%key:common::config_flow::abort::reconfigure_successful%]",
            "must_enable_2fa": "Для входа с использованием этого провайдера должна быть включена двухфакторная аутентификация.",

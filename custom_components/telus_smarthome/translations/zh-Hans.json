        "speak": {
            "fields": {
                "conditioning": {
                    "name": "音频预处理",
                    "description": "桥接服务在播放前是否对音频应用其默认的 ffmpeg 处理链。设为 false 时按解码后的原样播放。留空则保持桥接服务的默认设置。"
                },
                "audio_filter": {
                    "name": "音频滤镜",
                    "description": "桥接服务用来替代默认预处理的显式 ffmpeg `-af` 滤镜链（优先于 `conditioning`）。空字符串会完全禁用预处理。留空则保持桥接服务的默认设置。"
                }

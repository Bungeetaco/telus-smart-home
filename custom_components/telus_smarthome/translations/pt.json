                    "otp": "Palavra-passe de utilização única"
                }
            },
            "otp_select_method": {
                "title": "Selecionar método de autenticação de dois fatores",
                "data": {
                    "otp_method": "Método"
                }
            }
        },
        "error": {
            "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",

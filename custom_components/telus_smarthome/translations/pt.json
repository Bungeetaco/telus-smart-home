            "telus_sso_error": "O processo de início de sessão único da TELUS devolveu algo inesperado. Isto normalmente significa que a TELUS alterou algo do lado do servidor, não uma palavra-passe incorreta."
        },
        "abort": {
            "reauth_successful": "[%key:common::config_flow::abort::reauth_successful%]",
            "reconfigure_successful": "[%key:common::config_flow::abort::reconfigure_successful%]",

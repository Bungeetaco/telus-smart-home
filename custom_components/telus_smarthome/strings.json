{
  "config": {
    "step": {
      "user": {
        "data": {
          "username": "[%key:common::config_flow::data::username%]",
          "password": "[%key:common::config_flow::data::password%]"
        },
        "title": "Log In to TELUS Smart Home"
      },
      "reauth_confirm": {
        "title": "[%key:common::config_flow::title::reauth%]",
        "description": "TELUS Smart Home needs to re-authenticate your account."
      },
      "reconfigure": {
        "data": {
          "username": "[%key:common::config_flow::data::username%]",
          "password": "[%key:common::config_flow::data::password%]"
        },
        "title": "Update TELUS Smart Home Credentials",
        "description": "Enter your updated TELUS Smart Home username and password."
      },
      "otp_submit": {
        "title": "Enter One-Time Password",
        "description": "If you used the SMS or email authentication methods, an OTP has already been sent to your inbox.",
        "data": {
          "otp": "One-Time Password"
        }
      },
      "otp_select_method": {
        "title": "Select Two Factor Authentication Method",
        "data": {
          "otp_method": "Method"
        }
      }
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
      "unknown": "[%key:common::config_flow::error::unknown%]",
      "invalid_otp": "Invalid one-time password.",
      "telus_sso_error": "The TELUS single sign-on flow returned something unexpected. This usually means TELUS changed something server-side, not a wrong password."
    },
    "abort": {
      "reauth_successful": "[%key:common::config_flow::abort::reauth_successful%]",
      "reconfigure_successful": "[%key:common::config_flow::abort::reconfigure_successful%]",
      "must_enable_2fa": "Two-factor authentication must be enabled in order to log in with this provider.",
      "already_configured_account": "[%key:common::config_flow::abort::already_configured_account%]",
      "unique_id_mismatch": "The credentials entered belong to a different TELUS Smart Home account than the one being reauthenticated/reconfigured. Please enter credentials for the same account, or remove and re-add the integration to switch accounts."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "General Settings",
        "data": {
          "arm_code": "Security Code (Locks & Alarm)",
          "update_interval": "Update Interval",
          "ws_reconnect_timeout": "Websocket Reconnect Timeout"
        },
        "data_description": {
          "arm_code": "Sets the code to use when arming the alarm and unlocking locks via Home Assistant. To remove the pin, enter `CLEAR!`.",
          "update_interval": "Sets the rate at which Home Assistant checks TELUS Smart Home for updates. Be careful! Updating too frequently may result in an account lockout.",
          "ws_reconnect_timeout": "Sets the time to wait before attempting to reconnect the websocket on disconnection."
        }
      },
      "modes": {
        "title": "Arming Mode Profiles",
        "data": {
          "arm_home_options": "Arm Home",
          "arm_away_options": "Arm Away",
          "arm_night_options": "Arm Night"
        },
        "description": "Set arming behavior for each arming mode.",
        "data_description": {
          "arm_night_options": "Arm Night may not be available on all partitions."
        }
      },
      "call": {
        "title": "Doorbell Call",
        "description": "Ring-to-phone: the camera bridge can call your phone and connect the call to the doorbell's microphone and speaker. Needs a VoIP.ms sub-account; settings are pushed to the camera bridge and survive its restarts.",
        "data": {
          "call_enabled": "Enable doorbell calls",
          "call_sip_server": "VoIP.ms POP hostname",
          "call_sip_account": "SIP sub-account",
          "call_sip_password": "SIP password",
          "call_did": "Caller ID number (your DID)",
          "call_target": "Phone number to call"
        },
        "data_description": {
          "call_sip_server": "For example montreal10.voip.ms -- the POP your sub-account is registered against.",
          "call_target": "The number the doorbell dials, in E.164 form (+1...)."
        }
      }
    }
